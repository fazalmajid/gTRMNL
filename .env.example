# URL to render on the device screen (required)
TRMNL_URL=https://your-dashboard.example.com

# LAN address of this server, as reachable by the device (required)
TRMNL_BASE_URL=http://192.168.1.10:8080

# Host interface to bind to (default: all interfaces)
# TRMNL_HOST=192.168.1.10

# Port to listen on (default: 8080)
# TRMNL_PORT=8080

# Seconds between re-renders (default: 1800)
# TRMNL_REFRESH=1800

# Path to Chrome/Chromium binary (default in Docker: /usr/lib/chromium/chromium)
# TRMNL_CHROME=/usr/lib/chromium/chromium

# Access token the device must send in the access-token header (default: none = no auth)
# TRMNL_TOKEN=yourtoken
